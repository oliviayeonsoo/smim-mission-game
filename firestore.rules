rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /cafes/{cafeId} {
      // get: 카페 앱이 자기 cafeId 하나만 조회 (?cafe= 로 접속) — 로그인 없이 공개
      allow get: if true;
      // list: 전체 카페 목록 나열은 운영자 통합 대시보드(admin.html)에서만, 로그인 필요
      allow list: if request.auth != null;
      // create/delete: 카페 등록·삭제는 로그인한 운영자만 (admin.html 카페 추가 폼)
      allow create: if request.auth != null &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.wifiPassword is string && request.resource.data.wifiPassword.size() > 0 &&
        request.resource.data.adminPassword is string && request.resource.data.adminPassword.size() > 0;
      allow delete: if request.auth != null;
      // update: 로그인한 운영자는 자유롭게, 또는 카페 자체 비밀번호로는 wifiPassword만 변경 가능(기존 온사이트 관리자 패널)
      allow update: if request.auth != null || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wifiPassword', 'adminPasswordAttempt']) &&
        request.resource.data.wifiPassword is string &&
        request.resource.data.wifiPassword.size() > 0 &&
        request.resource.data.wifiPassword.size() < 100 &&
        request.resource.data.adminPasswordAttempt == resource.data.adminPassword
      );
    }

    match /cafes/{cafeId}/visits/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /cafes/{cafeId}/plays/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /cafes/{cafeId}/completions/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /cafes/{cafeId}/copies/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
  }
}
